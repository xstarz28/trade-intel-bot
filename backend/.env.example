# Copy to .env on the machine that will host Trade Intel Bot.
# Never commit backend/.env or put real secrets in GitHub source files.
DOMAIN=xstarzganaliys.com
NODE_ENV=production
APP_ORIGIN=https://xstarzganaliys.com
PUBLIC_BASE_URL=https://xstarzganaliys.com

# Optional one-time legacy account export only; leave blank for Convex-independent runtime.
VITE_LEGACY_CONVEX_URL=

# Required for production deploy and Google sign-in. Register this exact
# authorized redirect URI in the Google OAuth client:
# https://xstarzganaliys.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional stock news/sentiment and company fundamentals provider.
ALPHA_VANTAGE_API_KEY=

# Optional paid crypto derivatives source; public Binance/Bybit/OKX adapters remain available.
COINGLASS_API_KEY=

# Optional verified token unlock calendar; PatternPlus and CoinGecko fallbacks remain available.
TOKENOMIST_API_KEY=

# Optional economic calendar provider.
TICKATLAS_API_KEY=

# Optional EIA API key; public FRED inventory fallback is used when absent.
EIA_API_KEY=

# Required before SEC EDGAR refresh: use an identifying application name and monitored contact email.
SEC_USER_AGENT=

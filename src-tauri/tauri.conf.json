{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xstarz Analysis",
  "version": "0.1.0",
  "identifier": "app.xstarz.analysis.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Xstarz Analysis",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b1220",
        "decorations": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Xstarz",
    "copyright": "Copyright (c) Xstarz. All rights reserved.",
    "category": "Finance",
    "shortDescription": "Trading and investment decision-support intelligence.",
    "longDescription": "Xstarz Analysis is a decision-support tool for traders and investors. It presents market analysis, evidence provenance and explicit data-freshness state. It never places orders and never executes trades on your behalf.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}

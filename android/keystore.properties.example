# Phase 179 — Android release signing template.
#
# Copy to `android/keystore.properties` (GIT-IGNORED) on the release machine.
# NEVER commit the real file or the .jks keystore itself.
#
# Generate a release keystore (done by the release operator, NOT by this repo):
#   keytool -genkey -v -keystore xstarz-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias xstarz
#
# The SHA-256 of this certificate is required for Android App Links:
#   keytool -list -v -keystore xstarz-release.jks -alias xstarz
storeFile=/absolute/path/to/xstarz-release.jks
storePassword=
keyAlias=xstarz
keyPassword=

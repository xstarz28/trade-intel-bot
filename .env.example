# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Auth: Xstarz-owned OTP email delivery ────────────────────
# SERVER-ONLY. Set these in the Convex deployment environment
# (`npx convex env set ...`), never in the client bundle and never here.
#
# RETIRED in Phase 270: XSTARZ_EMAIL_TRANSPORT / XSTARZ_EMAIL_API_KEY /
# XSTARZ_EMAIL_SENDER_ADDRESS / XSTARZ_EMAIL_SENDER_NAME / XSTARZ_EMAIL_TIMEOUT_MS.
# The email-OTP sign-in provider and its delivery stack were removed; nothing
# reads these variables anymore, and the production config validators no longer
# require them. A still-set value is inert (reported as unexpected production‑
# shaped config instead of load‑bearing). Phase 185 history: these replaced the
# third‑party OTP delivery with an Xstarz‑owned transport (resend|smtp2go|console).
#
# Optional. SERVER-ONLY. Comma-separated owner principals that receive
# unlimited analysis without consuming the free allowance.
# Each entry is `email:<address>` or `user:<convexUsersId>`. Unset, empty, or
# malformed values match nobody (fail closed). Never VITE_-prefix this.
XSTARZ_OWNER_PRINCIPALS=

# Which deployment this is: production | preview | development.
# Set once per Convex deployment. Absent or empty is treated as production, so
# a forgotten variable fails closed (federated issuers refused, dev/preview
# identity checks tightened). An unrecognised value throws rather than
# silently downgrading. Convex exposes no runtime signal that distinguishes a
# production deployment from a dev one, which is why this is explicit.
XSTARZ_DEPLOYMENT_ENV=development

# Optional, and ONLY honoured when XSTARZ_DEPLOYMENT_ENV is preview or
# development. Federated sign-in from the legacy hosting platform. A production
# deployment rejects any value here: it trusts only its own issuer, because a
# party controlling an external issuer's JWKS could mint accepted identities.
VLY_CONVEX_AUTH_ISSUER=

# REMOVED in Phase 185:
#   OTP_EMAIL_API_KEY  - credential for the retired third-party OTP service.
#                        Still compromised in Git history; Phase 184 owns
#                        rotation and history remediation.
#   VLY_APP_NAME       - existed only to label that service's email.

# ── Market data providers ────────────────────────────────────
# All optional. A missing key disables that provider explicitly; it never
# causes fabricated or placeholder market data.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGLASS_API_KEY=
TICKATLAS_API_KEY=
EIA_API_KEY=

# OKX, CoinGecko, DeFiLlama, Tokenomist, CFTC and US Treasury are public
# endpoints and require no credentials.

# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Auth ─────────────────────────────────────────────────────
# API key for the OTP email delivery service.
# Set this in the Convex deployment environment, not in the client bundle.
OTP_EMAIL_API_KEY=

# Display name used in OTP emails.
VLY_APP_NAME=

# ── Market data providers ────────────────────────────────────
# All optional. A missing key disables that provider explicitly; it never
# causes fabricated or placeholder market data.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGLASS_API_KEY=
TICKATLAS_API_KEY=
EIA_API_KEY=

# OKX, CoinGecko, DeFiLlama, Tokenomist, CFTC and US Treasury are public
# endpoints and require no credentials.
